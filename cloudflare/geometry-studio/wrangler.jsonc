{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geometry-studio-cloud",
  "main": "./worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geometry-studio-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1104",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
